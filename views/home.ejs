<%- include('partials/header') %>

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Accueil - Plateforme</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    body {
      background: linear-gradient(to right, #f9f3ec, #e8e0d9);
      font-family: Arial, sans-serif;
      text-align: center;
      padding-top: 50px;
    }

    h1 {
      color: #333;
    }

    .menu {
      margin-top: 40px;
      display: flex;
      flex-direction: column;
      gap: 15px;
      align-items: center;
    }

    .menu a {
      text-decoration: none;
      background-color: #333;
      color: white;
      padding: 10px 25px;
      border-radius: 25px;
      width: 200px;
      transition: 0.3s ease;
    }

    .menu a:hover {
      background-color: #555;
    }

    #logout-btn {
      background-color: #ff5733;
      color: white;
      padding: 10px 20px;
      border-radius: 25px;
      width: 200px;
      margin-top: 20px;
      cursor: pointer;
    }

    #logout-btn:hover {
      background-color: #ff3311;
    }
  </style>
</head>
<body>
  <h1>Bienvenue sur la plateforme !</h1>
  <div class="menu">
    <a href="/login">Se connecter</a>
    <a href="/register">S'inscrire</a>
    <a href="/dashboard">Tableau de bord</a>
    <a href="/create-projet">Créer un projet</a>
    <a href="/invitation">Voir les invitations</a>
    <a href="/profile">Mon profil</a>
  </div>

  <!-- Afficher le bouton de déconnexion si l'utilisateur est connecté -->
  <div id="logout-section" style="display: none;">
    <button id="logout-btn">Se déconnecter</button>
  </div>

  <script>
    // Vérifier si l'utilisateur est connecté en vérifiant le token dans localStorage
    if (localStorage.getItem('token')) {
      // Si le token est présent, afficher le bouton de déconnexion
      document.getElementById('logout-section').style.display = 'block';
    }

    // Fonction de déconnexion
    document.getElementById('logout-btn')?.addEventListener('click', function() {
      // Supprimer le token de localStorage
      localStorage.removeItem('token');
      // Rediriger vers la page de connexion
      window.location.href = '/login';
    });
  </script>
</body>
</html>

<%- include('partials/footer') %>
