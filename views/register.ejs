<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Inscription</title><link rel="stylesheet" href="/css/style.css"></head><body>
    <div class="auth-container">
      <h1>Inscription</h1>
      <form id="registerForm">
        <input type="text" id="name" placeholder="Nom" required />
        <input type="email" id="email" placeholder="Email" required />
        <input type="password" id="password" placeholder="Mot de passe" required />
        <button type="submit">S'inscrire</button>
      </form>
      <p>Déjà inscrit ? <a href="/login">Connexion</a></p>
    </div>
    <script src="/js/auth.js"></script>
  </body></html>